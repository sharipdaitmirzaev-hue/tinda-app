# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# local product image uploads (keep directory)
/public/uploads/products/**
!/public/uploads/products/.gitkeep

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts


# Bavaria import HTTP cache (regenerable)
artifacts/bavaria-import/**/http-cache/

# Bavaria PDF page raster renders (regenerable via import:bavaria:pdf-ingest)
artifacts/bavaria-import/**/renders/
artifacts/bavaria-import/**/renders-small/

# Bavaria image-completion official source downloads (regenerate via script)
artifacts/bavaria-import/image-completion-*/source-downloads/

# Daryal stage2 regenerable downloads / debug crops
artifacts/daryal-import/**/source-downloads/
artifacts/daryal-import/**/raw-html/
artifacts/daryal-import/stage2-work/

# Local DB dumps from agent/VPS rehearsal (never commit)
/backups/

# Regenerable PNG sidecars of Bavaria processed webp
artifacts/bavaria-import/image-completion-*/processed/*.png

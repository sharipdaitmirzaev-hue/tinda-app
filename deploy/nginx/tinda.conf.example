# Пример Nginx для ТИНДА (HTTPS termination + reverse proxy).
# Подставьте свой домен и пути к сертификатам Let's Encrypt.

upstream tinda_app {
  server 127.0.0.1:3000;
  keepalive 32;
}

server {
  listen 80;
  server_name app.example.com;
  return 301 https://$host$request_uri;
}

server {
  listen 443 ssl http2;
  server_name app.example.com;

  ssl_certificate     /etc/letsencrypt/live/app.example.com/fullchain.pem;
  ssl_certificate_key /etc/letsencrypt/live/app.example.com/privkey.pem;

  client_max_body_size 8m;

  # App already sets many security headers; keep proxy minimal to avoid conflicts.
  add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

  location /api/v1/health {
    proxy_pass http://tinda_app;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }

  # Default: proxy to the app. After the uploads-ownership PR, the app serves
  # /uploads via a live filesystem route (no restart needed for new files).
  location /uploads/ {
    proxy_pass http://tinda_app;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    expires 7d;
    access_log off;
  }

  # Optional alternative (host can read the Docker volume): serve files directly
  # and skip Next for static product images.
  # location /uploads/ {
  #   alias /var/lib/docker/volumes/app_tinda_uploads/_data/;
  #   expires 7d;
  #   access_log off;
  # }

  location / {
    proxy_pass http://tinda_app;
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 60s;
  }
}

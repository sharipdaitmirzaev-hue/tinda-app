# PostgreSQL
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/tinda?schema=public"

# Секрет для подписи сессионной cookie (длинная случайная строка)
SESSION_SECRET="change-me-to-a-long-random-string"

# URL приложения
APP_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# Хранилище фотографий товаров (Э1.12)
# Секреты STORAGE_* никогда не должны попадать в клиентский JavaScript.
# ---------------------------------------------------------------------------

# local — файлы в public/uploads/products (удобно для разработки)
# s3    — S3-совместимое хранилище (production)
STORAGE_DRIVER="local"

# Обязательны при STORAGE_DRIVER=s3:
STORAGE_ENDPOINT="https://s3.example.com"
STORAGE_REGION="ru-1"
STORAGE_BUCKET="tinda-product-images"
STORAGE_ACCESS_KEY="replace-me"
STORAGE_SECRET_KEY="replace-me"
# Публичный базовый URL объектов (CDN или публичный endpoint bucket)
STORAGE_PUBLIC_URL="https://cdn.example.com/tinda-product-images"
